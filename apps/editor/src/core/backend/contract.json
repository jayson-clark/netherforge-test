    {
      "name": "the EULA is accepted once, and starting needs it",
      "steps": [
        { "call": "project_trust", "args": { "trusted": true }, "ok": { "trusted": true } },
        {
          "call": "server_eula_status",
          "ok": { "accepted": false, "url": "https://aka.ms/MinecraftEULA" }
