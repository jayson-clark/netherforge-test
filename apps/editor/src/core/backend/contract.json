{
  "$comment": "The backend contract: what MemoryBackend and the Rust backend must both do. Run by contract.test.ts (MemoryBackend) and src-tauri/src/commands/contract.rs (the real commands, through Tauri's IPC on its mock runtime). Each case starts from a fresh backend with `project` (project path -> text) at $ROOT, opened first unless `open` is false. A step calls a command by its Rust name with the arguments the UI sends, and expects `ok` (matched as a subset: every key given must match, \"$any\" matches anything, arrays match element by element) or an `error` code. \"$ROOT\" in a string is the project's absolute root. Each of `repositories` is a git repository at \"$GIT/<name>\" (a file:// URL), its files committed on main and tagged v1. A step with `save` keeps its answer (a string) as \"$<save>\" for the steps after it.",
  "project": {
    "netherforge.json": "{ \"name\": \"Contract\", \"namespace\": \"contract\", \"minecraft\": \"26.3\" }\n",
    "modules/shop/init.lua": "return {}\n",
    "B.txt": "upper\n",
    "a.txt": "lower\n",
    "_under.txt": "under\n",
    ".git/config": "[core]\n",
    ".netherforge/schema/centity.json": "{}\n"
  },
  "packages": {
    "lib": {
      "netherforge.json": "{ \"namespace\": \"lib\" }\n",
      "items/gem/item.json": "{}\n",
      "items/gem/script.lua": "-- gem\n",
      ".git/HEAD": "ref\n"
    },
    "notapackage": {
      "readme.txt": "hi\n"
    }
  },
  "repositories": {
    "lib": {
      "netherforge.json": "{ \"namespace\": \"lib\" }\n",
      "items/gem/item.json": "{}\n"
    }
  },
  "cases": [
    {
      "name": "a package beside the project is listed with digests, read and copied in, never over anything",
      "steps": [
        {
          "call": "packageFiles",
          "args": ["../lib"],
          "ok": {
            "root": "$any",
            "files": [
              {
                "path": "items/gem/item.json",
                "sha256": "ca3d163bab055381827226140568f3bef7eaac187cebd76878e0b63e9e442356"
              },
              {
                "path": "items/gem/script.lua",
                "sha256": "$any"
              },
              {
                "path": "netherforge.json",
                "sha256": "$any"
              }
            ]
          }
        },
        {
          "call": "packageReadText",
          "args": ["./../lib", "items/gem/script.lua"],
          "ok": "-- gem\n"
        },
        {
          "call": "packageReadText",
          "args": ["../lib", "../project/a.txt"],
          "error": "invalidPath"
        },
        {
          "call": "packageFiles",
          "args": ["../missing"],
          "error": "notFound"
        },
        {
          "call": "packageFiles",
          "args": ["../notapackage"],
          "error": "notFound"
        },
        {
          "call": "packageFiles",
          "args": ["/lib"],
          "error": "invalidPath"
        },
        {
          "call": "packageFiles",
          "args": ["..\\lib"],
          "error": "invalidPath"
        },
        {
          "call": "packageCopy",
          "args": ["../lib", "items/gem", "items/shiny"],
          "ok": null
        },
        {
          "call": "readText",
          "args": ["items/shiny/script.lua"],
          "ok": "-- gem\n"
        },
        {
          "call": "packageCopy",
          "args": ["../lib", "items/gem", "items/shiny"],
          "error": "alreadyExists"
        },
        {
          "call": "packageCopy",
          "args": ["../lib", "items/gem", ".git/hooks"],
          "error": "readOnly"
        },
        {
          "call": "packageCopy",
          "args": ["../lib", "items/none", "items/none"],
          "error": "notFound"
        }
      ]
    },
    {
      "name": "a git package is fetched into the package cache and read at git:<commit>, a pinned one without the network",
      "steps": [
        {
          "call": "trustProject",
          "args": [true],
          "ok": {
            "trusted": true
          }
        },
        {
          "call": "packageFetchGit",
          "args": ["$GIT/lib", "v1", null],
          "ok": "$any",
          "save": "commit"
        },
        {
          "call": "packageFiles",
          "args": ["git:$commit"],
          "ok": {
            "root": "$any",
            "files": [
              {
                "path": "items/gem/item.json",
                "sha256": "ca3d163bab055381827226140568f3bef7eaac187cebd76878e0b63e9e442356"
              },
              {
                "path": "netherforge.json",
                "sha256": "$any"
              }
            ]
          }
        },
        {
          "call": "packageReadText",
          "args": ["git:$commit", "items/gem/item.json"],
          "ok": "{}\n"
        },
        {
          "call": "packageFetchGit",
          "args": ["$GIT/lib", null, null],
          "ok": "$commit"
        },
        {
          "call": "packageFetchGit",
          "args": ["$GIT/gone", "v1", "$commit"],
          "ok": "$commit"
        },
        {
          "call": "packageFetchGit",
          "args": ["$GIT/lib", "nope", null],
          "error": "network"
        },
        {
          "call": "packageFetchGit",
          "args": ["$GIT/lib", null, "ffffffffffffffffffffffffffffffffffffffff"],
          "error": "notFound"
        },
        {
          "call": "packageFetchGit",
          "args": ["http://example.com/lib.git", null, null],
          "error": "invalid"
        },
        {
          "call": "packageFetchGit",
          "args": ["ext::sh -c touch% pwned", null, null],
          "error": "invalid"
        },
        {
          "call": "packageFetchGit",
          "args": ["$GIT/lib", "-x", null],
          "error": "invalid"
        },
        {
          "call": "packageFetchGit",
          "args": ["$GIT/lib", null, "abc"],
          "error": "invalid"
        },
        {
          "call": "packageFiles",
          "args": ["git:abc"],
          "error": "invalidPath"
        },
        {
          "call": "packageFiles",
          "args": ["git:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"],
          "error": "notFound"
        }
      ]
    },
    {
      "name": "an untrusted project edits, but nothing runs or reaches out for it until it's trusted",
      "steps": [
        {
          "call": "writeText",
          "args": ["a.txt", "edited\n"],
          "ok": null
        },
        {
          "call": "startServer",
          "error": "untrusted"
        },
        {
          "call": "runTests",
          "error": "untrusted"
        },
        {
          "call": "lualsStart",
          "error": "untrusted"
        },
        {
          "call": "packageFetchGit",
          "args": ["$GIT/lib", "v1", null],
          "error": "untrusted"
        },
        {
          "call": "packageFetchGit",
          "args": ["http://example.com/lib.git", null, null],
          "error": "invalid"
        },
        {
          "call": "trustProject",
          "args": [true],
          "ok": {
            "root": "$ROOT",
            "name": "Contract",
            "trusted": true
          }
        },
        {
          "call": "openProject",
          "args": ["$ROOT"],
          "ok": {
            "trusted": true
          }
        },
        {
          "call": "startServer",
          "error": "eulaRequired"
        },
        {
          "call": "packageFetchGit",
          "args": ["$GIT/lib", "v1", null],
          "ok": "$any",
          "save": "commit"
        },
        {
          "call": "trustProject",
          "args": [false],
          "ok": {
            "trusted": false
          }
        },
        {
          "call": "startServer",
          "error": "untrusted"
        },
        {
          "call": "runTests",
          "args": ["greets"],
          "error": "untrusted"
        },
        {
          "call": "packageFetchGit",
          "args": ["$GIT/lib", "v1", "$commit"],
          "ok": "$commit"
        },
        {
          "call": "closeProject",
          "ok": null
        },
        {
          "call": "trustProject",
          "args": [true],
          "error": "noProject"
        },
        {
          "call": "openProject",
          "args": ["$ROOT"],
          "ok": {
            "trusted": false
          }
        }
      ]
    },
    {
      "name": "file commands need an open project",
      "open": false,
      "steps": [
        {
          "call": "listFiles",
          "error": "noProject"
        },
        {
          "call": "readText",
          "args": ["a.txt"],
          "error": "noProject"
        },
        {
          "call": "writeText",
          "args": ["a.txt", "x"],
          "error": "noProject"
        },
        {
          "call": "runTests",
          "error": "noProject"
        }
      ]
    },
    {
      "name": "opening a project names it from its manifest and remembers it",
      "open": false,
      "steps": [
        {
          "call": "openProject",
          "args": ["$ROOT/modules"],
          "error": "invalid"
        },
        {
          "call": "openProject",
          "args": ["$ROOT"],
          "ok": {
            "root": "$ROOT",
            "name": "Contract",
            "trusted": false
          }
        },
        {
          "call": "recentProjects",
          "ok": [
            {
              "root": "$ROOT",
              "name": "Contract",
              "openedAt": "$any"
            }
          ]
        },
        {
          "call": "closeProject",
          "ok": null
        },
        {
          "call": "listFiles",
          "error": "noProject"
        }
      ]
    },
    {
      "name": "listing is sorted byte-wise and hides .git and .netherforge",
      "steps": [
        {
          "call": "listFiles",
          "ok": [
            {
              "path": "B.txt",
              "size": 6,
              "modified": "$any"
            },
            {
              "path": "_under.txt",
              "size": 6,
              "modified": "$any"
            },
            {
              "path": "a.txt",
              "size": 6,
              "modified": "$any"
            },
            {
              "path": "modules/shop/init.lua",
              "size": 10,
              "modified": "$any"
            },
            {
              "path": "netherforge.json",
              "size": "$any",
              "modified": "$any"
            }
          ]
        }
      ]
    },
    {
      "name": "text round-trips and writes make their folders",
      "steps": [
        {
          "call": "writeText",
          "args": ["deep/er/note.md", "hi\n"],
          "ok": null
        },
        {
          "call": "readText",
          "args": ["deep/er/note.md"],
          "ok": "hi\n"
        },
        {
          "call": "writeText",
          "args": ["a.txt", "again"],
          "ok": null
        },
        {
          "call": "readText",
          "args": ["a.txt"],
          "ok": "again"
        }
      ]
    },
    {
