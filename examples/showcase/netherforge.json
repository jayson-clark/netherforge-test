{
  "$schema": ".netherforge/schema/netherforge.schema.json",
  "formatVersion": 1,
  "name": "NetherForge Showcase",
  "namespace": "showcase",
  "version": "0.1.0",
  "minecraft": "26.3",
  "managedWorlds": ["lobby"],
  "worlds": {
    "hills": {
      "terrain": "ruby_hills",
      "seed": 42,
      "dimensionType": "deep"
    },
    "lobby": {
      "spawnLimits": {
        "monster": 0
      }
    },
    "sky": {
      "spawnLimits": {
        "monster": 0
      },
      "terrain": "sky_islands",
      "seed": 7031,
      "dimensionType": "sky"
    },
    "world": {
      "spawnLimits": {
        "monster": 0,
        "animal": 0
      },
      "terrain": "plaza"
    }
  },
  "requires": {
    "db": true,
    "web": true,
    "bots": true,
    "wasm": true
  },
  "allow": {
    "permissions": ["showcase"]
  },
  "dependencies": {
    "library": {
      "path": "../library"
    }
  },
  "settings": {
    "greeting": {
      "type": "string",
      "description": "What the greeter says to everyone who joins, before their name.",
      "default": "Welcome"
    },
    "show_welcome": {
      "type": "boolean",
      "description": "Whether a player's first join opens the welcome dialog.",
      "default": true
    },
    "tour_bossbar": {
      "type": "boolean",
      "description": "Whether the expo shows a boss bar naming the booth a player stands in, and how much of the tour they've seen.",
      "default": true
    },
    "treasure_rolls": {
      "type": "integer",
      "description": "How many times /treasure rolls the treasure loot table.",
      "default": 1,
      "min": 1,
      "max": 5
    }
  }
}
