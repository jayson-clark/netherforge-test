{
  "$schema": "../../.netherforge/schema/centity.schema.json",
  "name": "Floating lamp",
  "nodes": {
    "label": {
      "parent": "light",
      "transform": {
        "translation": [0.25, 0.8, 0.25]
      },
      "display": {
        "type": "text",
        "text": "<yellow>Lamp",
        "billboard": "center"
      }
    },
    "light": {
      "transform": {
        "scale": [0.5, 0.5, 0.5]
      },
      "display": {
        "type": "block",
        "block": "minecraft:sea_lantern"
      },
      "hitbox": {
        "boxes": [
          {
            "min": [0, 0, 0],
            "max": [0.5, 0.5, 0.5]
          }
        ]
      }
    }
  },
  "animations": {
    "bob": {
      "loop": "loop",
      "autoplay": true,
      "tracks": {
        "light": {
          "translation": [
            {
              "time": 0,
              "value": [0, 0, 0],
              "easing": "ease_in_out"
            },
            {
              "time": 1,
              "value": [0, 0.25, 0],
              "easing": "ease_in_out"
            },
            {
              "time": 2,
              "value": [0, 0, 0]
            }
          ]
        }
      }
    }
  }
}
