{
  "$schema": "../.netherforge/schema/loot_table.schema.json",
  "pools": {
    "glimmer": {
      "conditions": [
        {
          "type": "tool",
          "tool": {
            "item": "lumen_pickaxe"
          }
        }
      ],
      "entries": [
        {
          "type": "item",
          "item": {
            "item": "lumen_shard"
          }
        }
      ]
    },
    "shards": {
      "entries": [
        {
          "type": "item",
          "item": {
            "item": "lumen_shard"
          },
          "count": {
            "min": 1,
            "max": 2
          }
        }
      ]
    }
  }
}
