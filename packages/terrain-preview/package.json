{
  "name": "@netherforge/terrain-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "What the terrain preview draws, shared by the editor and the netherforge command: colours and pixels from format's numbers, and the project structures (NBT) a generator's decorations place",
  "exports": {
    ".": "./src/index.ts",
    "./nbt": "./src/nbt.ts",
    "./structure": "./src/structure.ts",
    "./lua.browser": "./src/lua.browser.ts",
    "./lua.node": "./src/lua.node.ts"
  },
  "scripts": {
    "lint": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@netherforge/format": "workspace:*",
    "nbtify": "2.2.0",
    "wasmoon": "1.16.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
